# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PayPal Configuration (Required for paid eBook checkout)
# Get credentials from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PORT=3000

# Private eBook storage directory (PDFs must NOT be placed in public/ or public_html/)
# On Hostinger VPS/cPanel: e.g. /home/u123456789/storage/ebooks or ./storage/ebooks
EBOOK_STORAGE_PATH=./storage/ebooks
